<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AdaptedPhysicalEducationApp.EquipmentDetails"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*"
          Padding="15,10">

        <!-- Header -->
        <Grid ColumnDefinitions="40,*,40"
              Margin="5,10,5,15">

            <Label Grid.Column="0"
                   Text="‹"
                   FontSize="40"
                   TextColor="Black"
                   VerticalOptions="Center"/>

            <Label Grid.Column="1"
                   Text="Modified Basketball"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <Label Grid.Column="2"
                   Text="☆"
                   FontSize="35"
                   TextColor="Black"
                   VerticalOptions="Center"
                   HorizontalOptions="End"/>
        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Spacing="15"
                                 Padding="5,0,5,20">

                <!-- Basketball image -->
                <Image Source="modified_basketball.png"
                       HeightRequest="250"
                       Aspect="AspectFit"/>

                <!-- Description -->
                <VerticalStackLayout Spacing="5">

                    <Label Text="Description"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <Label Text="A basketball with handles can help students with limited hand strength or coordination. The handles make it easier to hold, pass, and shoot the ball."
                           FontSize="20"
                           TextColor="Black"/>
                </VerticalStackLayout>

                <!-- Modification steps box -->
                <Border BackgroundColor="#E3F0FF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        Padding="15">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Modification Steps"
                               FontSize="23"
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <!-- Step 1 -->
                        <Grid ColumnDefinitions="45,*"
                              ColumnSpacing="10">

                            <Border BackgroundColor="#0866CD"
                                    StrokeThickness="0"
                                    StrokeShape="Ellipse"
                                    WidthRequest="38"
                                    HeightRequest="38">

                                <Label Text="1"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Attach handles to the basketball."
                                   FontSize="19"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Step 2 -->
                        <Grid ColumnDefinitions="45,*"
                              ColumnSpacing="10">

                            <Border BackgroundColor="#0866CD"
                                    StrokeThickness="0"
                                    StrokeShape="Ellipse"
                                    WidthRequest="38"
                                    HeightRequest="38">

                                <Label Text="2"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Ensure handles are secure."
                                   FontSize="19"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Step 3 -->
                        <Grid ColumnDefinitions="45,*"
                              ColumnSpacing="10">

                            <Border BackgroundColor="#0866CD"
                                    StrokeThickness="0"
                                    StrokeShape="Ellipse"
                                    WidthRequest="38"
                                    HeightRequest="38">

                                <Label Text="3"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Allow the student to practice holding and passing."
                                   FontSize="19"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Step 4 -->
                        <Grid ColumnDefinitions="45,*"
                              ColumnSpacing="10">

                            <Border BackgroundColor="#0866CD"
                                    StrokeThickness="0"
                                    StrokeShape="Ellipse"
                                    WidthRequest="38"
                                    HeightRequest="38">

                                <Label Text="4"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Adjust handle size if needed."
                                   FontSize="19"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
