<?xml version="1.0" encoding="utf-8" ?>
<!--Alex Martinez Screen 10 Student Support Strategies-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AdaptedPhysicalEducationApp.StudentSupportStrategies"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,72">

        <!-- Main Content -->
        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="20,25,20,10"
                Spacing="0">

                <!-- Back Button -->
                <Button
                    Text="‹"
                    FontSize="32"
                    TextColor="Black"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    Padding="0"/>

                <!-- Title -->
                <Label
                    Text="Student Support Strategies"
                    FontSize="23"
                    FontAttributes="Bold"
                    TextColor="#111111"
                    HorizontalTextAlignment="Center"
                    Margin="0,-35,0,22"/>

                <!-- Search -->
                <SearchBar
                    Placeholder="Search strategies..."
                    BackgroundColor="#F3F3F5"
                    Margin="0,0,0,15"/>

                <!-- Sensory Support -->
                <Border
                    BackgroundColor="#FCE0E0"
                    StrokeThickness="0"
                    HeightRequest="92"
                    StrokeShape="RoundRectangle 14"
                    Margin="0,0,0,14">

                    <Grid
                        ColumnDefinitions="85,*,35"
                        Padding="8,5">

                        <Label
                            Text="👂"
                            FontSize="42"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="Sensory Support"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#171717"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="34"
                            TextColor="#222222"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                    </Grid>
                </Border>

                <!-- Physical Support -->
                <Border
                    BackgroundColor="#DFEDFF"
                    StrokeThickness="0"
                    HeightRequest="92"
                    StrokeShape="RoundRectangle 14"
                    Margin="0,0,0,14">

                    <Grid
                        ColumnDefinitions="85,*,35"
                        Padding="8,5">

                        <Label
                            Text="♿"
                            FontSize="42"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="Physical Support"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#171717"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="34"
                            TextColor="#222222"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                    </Grid>
                </Border>

                <!-- Cognitive Support -->
                <Border
                    BackgroundColor="#DDF4E4"
                    StrokeThickness="0"
                    HeightRequest="92"
                    StrokeShape="RoundRectangle 14"
                    Margin="0,0,0,14">

                    <Grid
                        ColumnDefinitions="85,*,35"
                        Padding="8,5">

                        <Label
                            Text="🧠"
                            FontSize="42"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="Cognitive Support"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#171717"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="34"
                            TextColor="#222222"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                    </Grid>
                </Border>

                <!-- Behavior Support -->
                <Border
                    BackgroundColor="#FFF2C6"
                    StrokeThickness="0"
                    HeightRequest="92"
                    StrokeShape="RoundRectangle 14"
                    Margin="0,0,0,14">

                    <Grid
                        ColumnDefinitions="85,*,35"
                        Padding="8,5">

                        <Label
                            Text="👥"
                            FontSize="42"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="Behavior Support"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#171717"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="34"
                            TextColor="#222222"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                    </Grid>
                </Border>

                <!-- Communication Support -->
                <Border
                    BackgroundColor="#E7DEFF"
                    StrokeThickness="0"
                    HeightRequest="92"
                    StrokeShape="RoundRectangle 14">

                    <Grid
                        ColumnDefinitions="85,*,35"
                        Padding="8,5">

                        <Label
                            Text="♡"
                            FontSize="54"
                            TextColor="#4930A4"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="Communication Support"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#171717"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="34"
                            TextColor="#222222"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                    </Grid>
                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Bottom Navigation -->
        <Border
            Grid.Row="1"
            BackgroundColor="White"
            Stroke="#E2E2E2"
            StrokeThickness="1">

            <Grid
                ColumnDefinitions="*,*,*,*"
                Padding="5,4">

                <!-- Home -->
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="⌂"
                        FontSize="27"
                        TextColor="#1464D2"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Home"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#1464D2"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

                <!-- Search -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="⌕"
                        FontSize="27"
                        TextColor="#52606D"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Search"
                        FontSize="11"
                        TextColor="#52606D"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

                <!-- Favorites -->
                <VerticalStackLayout
                    Grid.Column="2"
                    Spacing="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="♡"
                        FontSize="29"
                        TextColor="#52606D"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Favorites"
                        FontSize="11"
                        TextColor="#52606D"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

                <!-- Settings -->
                <VerticalStackLayout
                    Grid.Column="3"
                    Spacing="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="⚙"
                        FontSize="25"
                        TextColor="#52606D"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Settings"
                        FontSize="11"
                        TextColor="#52606D"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentPage>
